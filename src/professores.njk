---
layout: base.njk
pageKey: teachers
pagination:
  data: site.localeCodes
  size: 1
  alias: locale
permalink: "{{ site.pages.teachers[locale] }}"
---

<section class="page-head">
  <div class="wrap-narrow">
    <span class="eyebrow">{{ teachers.intro | loc('label', locale) }}</span>
    <h1 class="page-title">{{ teachers.intro | loc('heading', locale) }}</h1>
    <p class="section-desc">{{ teachers.intro | loc('body', locale) }}</p>
  </div>
</section>

<section class="section section-teachers">
  <div class="wrap-narrow">
    <ul class="teacher-grid">
      {% for teacher in teachers.list %}
      <li class="teacher-card reveal">
        {% if teacher.photo %}
        <img class="teacher-photo" src="{{ teacher.photo | img }}" alt="{{ teacher.name }}" loading="lazy">
        {% else %}
        <span class="teacher-photo teacher-photo-placeholder" aria-hidden="true">{{ teacher.name | truncate(1, true, '') }}</span>
        {% endif %}
        <h2 class="teacher-name">{{ teacher.name }}</h2>
        <p class="teacher-role">{{ teacher | loc('role', locale) }}</p>
        <a class="link-quiet" href="{{ site.pages.teachers[locale] }}{{ teacher.slug }}/">{{ t.view_schedule }}</a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

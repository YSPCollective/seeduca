<!doctype html>
<html lang="{{ htmlLang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ site.pages[pageKey][locale] }}">

  {% for l in site.locales %}
  <link rel="alternate" hreflang="{{ l.htmlLang }}" href="{{ site.url }}{{ site.pages[pageKey][l.code] }}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ site.pages[pageKey][site.defaultLocale] }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ site.pages[pageKey][locale] }}">
  <meta property="og:locale" content="{{ htmlLang | replace('-', '_') }}">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700&family=Nunito+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
  <a class="skip-link" href="#main">{{ t.skip_to_content }}</a>

  {% include "nav.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  {% if contact.whatsapp %}
  <a class="whatsapp-float" href="https://wa.me/{{ contact.whatsapp }}" rel="noopener noreferrer" target="_blank" aria-label="{{ t.whatsapp_label }}" title="{{ t.whatsapp_label }}">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M12 3a9 9 0 0 0-7.75 13.55L3 21l4.6-1.2A9 9 0 1 0 12 3Zm0 1.8a7.2 7.2 0 0 1 6.13 10.98l-.17.28.68 2.48-2.55-.66-.27.16A7.2 7.2 0 1 1 12 4.8Zm-2.97 3.4c-.18 0-.47.07-.72.35-.24.28-.94.9-.94 2.2 0 1.3.96 2.55 1.1 2.73.14.18 1.86 2.98 4.6 4.06 2.28.9 2.74.72 3.24.68.5-.05 1.6-.65 1.83-1.28.22-.63.22-1.17.16-1.28-.06-.11-.22-.18-.47-.31-.24-.13-1.44-.71-1.66-.79-.22-.08-.39-.12-.55.13-.16.24-.63.79-.78.95-.14.16-.28.18-.53.06-.24-.13-1.02-.38-1.95-1.21-.72-.64-1.2-1.44-1.35-1.68-.14-.24-.02-.37.11-.5.11-.11.24-.28.37-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.13-.55-1.36-.76-1.86-.2-.48-.4-.42-.55-.42Z"/>
    </svg>
  </a>
  {% endif %}

  <script src="/assets/js/site.js" defer></script>
</body>
</html>
